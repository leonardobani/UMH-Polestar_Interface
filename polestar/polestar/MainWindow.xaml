<Window x:Class="polestar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:polestar"
        mc:Ignorable="d"
        Title="MainWindow" Height="840" Width="840">
<Grid Background="White">
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.Column="0" Background="Black" Margin="5">
        <Grid Background="Transparent">
            
            <Image Source="../images/2nature.png"/>
                        
            <Rectangle x:Name="FiltroScuro1" Fill="Black" Opacity="0" />
            
            <StackPanel x:Name="ContenutoHover1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30" Opacity="0">
                <TextBlock Text="Polestar 2" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15" />
                <Button Content="Configura ora" Width="125" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="14" />
            </StackPanel>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FiltroScuro1" 
                                             Storyboard.TargetProperty="Opacity" 
                                             To="0.6" Duration="0:0:0.3" />
                            <!-- Fa comparire il testo e il bottone -->
                            <DoubleAnimation Storyboard.TargetName="ContenutoHover1" 
                                             Storyboard.TargetProperty="Opacity" 
                                             To="1" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FiltroScuro1" 
                                             Storyboard.TargetProperty="Opacity" 
                                             To="0" Duration="0:0:0.3" />
                            <DoubleAnimation Storyboard.TargetName="ContenutoHover1" 
                                             Storyboard.TargetProperty="Opacity" 
                                             To="0" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

        </Grid>
    </Border>















    <Border Grid.Row="0" Grid.Column="1" Background="Black" Margin="5">
        <Image Source="../images/3nature.png"/>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="Black" Margin="5">
        <Image Source="../images/4nature.png"/>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" Background="Black" Margin="5">
        <Image Source="../images/5nature.png" />
    </Border>


    <Image Source="../images/logo.png" 
           Grid.RowSpan="2" 
           Grid.ColumnSpan="2" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Width="400" Height="400"
           />
</Grid>
</Window>
