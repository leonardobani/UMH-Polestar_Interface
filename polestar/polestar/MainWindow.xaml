<Window x:Class="polestar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:polestar"
        mc:Ignorable="d"
        Title="Polestar" Height="840" Width="840"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style x:Key="HeaderLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FooterLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextDecorations" Value="Underline" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#111111" 
                BorderBrush="#33FFFFFF" 
                BorderThickness="0,0,0,1" 
                Height="65" 
                Panel.ZIndex="100">
            <Grid>
                <Button x:Name="BtnDrawer" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center" 
                        Margin="18,0,0,0" 
                        Width="58" Height="42" 
                        Background="Transparent" 
                        BorderBrush="#55FFFFFF" 
                        BorderThickness="1" 
                        Cursor="Hand" 
                        ToolTip="drawer button"
                        Click="BtnDrawer_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="btnBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Background="White" Height="2" Width="20" Margin="0,0,0,4" CornerRadius="1" />
                                    <Border Background="White" Height="2" Width="20" Margin="0,0,0,4" CornerRadius="1" />
                                    <Border Background="White" Height="2" Width="20" CornerRadius="1" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="btnBorder" Property="Background" Value="#25FFFFFF" />
                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Image Source="/images/logo.png" 
                       Width="34" Height="34" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Cursor="Hand" 
                       ToolTip="Ir a Inicio"
                       MouseLeftButtonUp="LogoHeader_Click" />

                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Margin="0,0,20,0">
                    
                    <TextBlock Text="Inicio" 
                               Style="{StaticResource HeaderLinkStyle}" 
                               Margin="0,0,20,0" 
                               MouseLeftButtonUp="HeaderLink1_Click" />
                    
                    <TextBlock Text="Galería" 
                               Style="{StaticResource HeaderLinkStyle}" 
                               Margin="0,0,20,0" 
                               MouseLeftButtonUp="HeaderLink2_Click" />
                    
                    <TextBlock Text="Modelos" 
                               Style="{StaticResource HeaderLinkStyle}" 
                               Margin="0,0,20,0" 
                               MouseLeftButtonUp="HeaderLink3_Click" />

                    <TextBlock Text="Identificación" 
                               Style="{StaticResource HeaderLinkStyle}" 
                               Margin="0,0,24,0" 
                               MouseLeftButtonUp="HeaderLogin_Click" />

                    <Border Background="#1F1F1F" 
                            BorderBrush="#44FFFFFF" 
                            BorderThickness="1" 
                            CornerRadius="16" 
                            Height="34" 
                            Padding="12,0,14,0" 
                            Cursor="Hand" 
                            ToolTip="Buscar modelo"
                            MouseLeftButtonUp="HeaderSearch_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" 
                                       FontSize="12" 
                                       VerticalAlignment="Center" 
                                       Margin="0,0,6,0" />
                            <TextBlock Text="Search" 
                                       Foreground="White" 
                                       FontSize="13" 
                                       FontWeight="Medium" 
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" 
                      x:Name="MainScrollViewer" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <StackPanel Background="White">

                <!-- Seccion Hero -->
                <Grid x:Name="SectionHero" Height="800" Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Polestar 2 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="Black" Margin="5">
                        <Grid Background="Transparent" MouseEnter="HeroCard_MouseEnter" MouseLeave="HeroCard_MouseLeave" Tag="1">
                            <Image Source="/images/2nature.png"/>
                            
                            <!-- Badge de oferta/campaña -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#CC111114" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="OFERTA DESTACADA" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <Rectangle x:Name="FiltroScuro1" Fill="Black" Opacity="0" />
                            <StackPanel x:Name="ContenutoHover1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30" Opacity="0">
                                <TextBlock Text="Polestar 2" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Desde 44.900 € | Campaña 0% TAE" Foreground="#E0E0E0" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Configurar" Width="130" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="14" Cursor="Hand" Click="ScrollToPolestar2_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Polestar 3 -->
                    <Border Grid.Row="0" Grid.Column="1" Background="Black" Margin="5">
                        <Grid Background="Transparent" MouseEnter="HeroCard_MouseEnter" MouseLeave="HeroCard_MouseLeave" Tag="2">
                            <Image Source="/images/3nature.png"/>
                            
                            <!-- Badge de novedad -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#CC111114" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="NOVEDAD SUV" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <Rectangle x:Name="FiltroScuro2" Fill="Black" Opacity="0" />
                            <StackPanel x:Name="ContenutoHover2" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30" Opacity="0">
                                <TextBlock Text="Polestar 3" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Desde 88.900 € | Entrega inmediata" Foreground="#E0E0E0" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Configurar" Width="130" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="14" Cursor="Hand" Click="ScrollToPolestar3_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Polestar 4 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="Black" Margin="5">
                        <Grid Background="Transparent" MouseEnter="HeroCard_MouseEnter" MouseLeave="HeroCard_MouseLeave" Tag="3">
                            <Image Source="/images/4nature.png"/>
                            
                            <!-- Badge de campaña -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#CC111114" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="CAMPAÑA 2026" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <Rectangle x:Name="FiltroScuro3" Fill="Black" Opacity="0" />
                            <StackPanel x:Name="ContenutoHover3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30" Opacity="0">
                                <TextBlock Text="Polestar 4" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Desde 65.900 € | SUV Coupé" Foreground="#E0E0E0" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Configurar" Width="130" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="14" Cursor="Hand" Click="ScrollToPolestar4_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Polestar 5 -->
                    <Border Grid.Row="1" Grid.Column="1" Background="Black" Margin="5">
                        <Grid Background="Transparent" MouseEnter="HeroCard_MouseEnter" MouseLeave="HeroCard_MouseLeave" Tag="4">
                            <Image Source="/images/5nature.png"/>
                            
                            <!-- Badge de proximamente -->
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Background="#CC111114" CornerRadius="4" Padding="10,4">
                                <TextBlock Text="PRÓXIMAMENTE" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>

                            <Rectangle x:Name="FiltroScuro4" Fill="Black" Opacity="0" />
                            <StackPanel x:Name="ContenutoHover4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,30" Opacity="0">
                                <TextBlock Text="Polestar 5" Foreground="White" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Gran Turismo 884 CV | Concept Precept" Foreground="#E0E0E0" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <Button Content="Descubrir" Width="130" Height="40" Background="Transparent" Foreground="White" BorderBrush="White" BorderThickness="1" FontSize="14" Cursor="Hand" Click="ScrollToPolestar5_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Image Source="/images/logo.png" 
                           Grid.RowSpan="2" 
                           Grid.ColumnSpan="2" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Width="400" Height="400" 
                           IsHitTestVisible="False" />
                </Grid>

                <!-- Seccion Showcase -->
                <Grid x:Name="SectionShowcase" Height="800" Background="#232323" ClipToBounds="True">
                    
                    <Path x:Name="LogoGeometryPath" 
                          Fill="White" 
                          Data="M 12.549,0 L 12.092,0.555 V 11.746 H 23.282 L 23.836,11.289 L 14.436,9.399 Z M 0.719,12.26 L 0.164,12.717 L 9.563,14.6 L 11.449,24 L 11.906,23.445 V 12.26 Z"
                          Stretch="Uniform"
                          Width="520" Height="520"
                          HorizontalAlignment="Left" 
                          VerticalAlignment="Center" 
                          Margin="-150,200,0,0"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="LogoRotateTransform" Angle="0" />
                        </Path.RenderTransform>
                    </Path>

                    <StackPanel x:Name="ShowcaseContentPanel" Margin="90,55,90,0" VerticalAlignment="Top">
                        <TextBlock x:Name="ShowcaseHeading" 
                                   Text="{Binding SelectedCar.Name}" 
                                   Foreground="White" 
                                   FontSize="34" 
                                   FontWeight="SemiBold" 
                                   Margin="0,0,0,16" />

                        <TextBlock x:Name="ShowcaseSubtitle" 
                                   Text="{Binding SelectedCar.Subtitle}" 
                                   Foreground="#E0E0E0" 
                                   FontSize="13.5" 
                                   TextWrapping="Wrap" 
                                   LineHeight="20" 
                                   Margin="0,0,0,18" />

                        <TextBlock x:Name="ShowcaseDescription" 
                                   Text="{Binding SelectedCar.Description}" 
                                   Foreground="#C5C5C5" 
                                   FontSize="13" 
                                   TextWrapping="Wrap" 
                                   LineHeight="20" 
                                   Margin="0,0,0,28" />

                        <Grid Margin="0,6,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="Ficha técnica" 
                                           Foreground="White" 
                                           FontSize="14" 
                                           TextDecorations="Underline" 
                                           Cursor="Hand" 
                                           Margin="0,0,35,0" />
                                <Button HorizontalAlignment="Left" 
                                        Content="Configurar" 
                                        Width="135" Height="40" 
                                        Background="Transparent" 
                                        Foreground="White" 
                                        BorderBrush="White" 
                                        BorderThickness="1" 
                                        FontSize="14" 
                                        FontWeight="Medium" 
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBrd" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBrd" Property="Background" Value="#25FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBrd" Property="Background" Value="#45FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Image x:Name="ShowcaseCarImage" 
                           Source="{Binding SelectedCar.ImageSource}" 
                           Width="620" 
                           Stretch="Uniform" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Bottom" 
                           Margin="0,0,0,105" />

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Bottom" 
                                Margin="0,0,45,40">
                        
                        <TextBlock x:Name="CarIndexText" 
                                   Text="{Binding CarIndexDisplay}" 
                                   Foreground="#888888" 
                                   FontSize="13" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,20,0" />

                        <Button x:Name="BtnNextCar" 
                                Width="48" Height="48" 
                                Background="Transparent" 
                                BorderBrush="White" 
                                BorderThickness="1.5" 
                                Cursor="Hand"
                                Click="BtnNextCar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            CornerRadius="24">
                                        <Path Data="M 0,0 L 7,7 L 0,14" 
                                              Stroke="White" 
                                              StrokeThickness="2" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              Margin="2,0,0,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                                            <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#55FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </Grid>

                <!-- Seccion Modelos -->
                <Grid x:Name="SectionBigText" Height="800" Background="White">
                    
                    <StackPanel VerticalAlignment="Top" Margin="0,50,0,0">
                        <TextBlock Text="Polestar 2&gt;" 
                                   Tag="0" 
                                   FontSize="62" 
                                   FontWeight="Normal" 
                                   Foreground="#111111" 
                                   Margin="60,0,0,12" 
                                   Cursor="Hand" 
                                   MouseEnter="MenuCar_MouseEnter" 
                                   MouseLeave="MenuCar_MouseLeave"
                                   MouseLeftButtonUp="MenuCar_Click" />

                        <TextBlock Text="Polestar 3&gt;" 
                                   Tag="1" 
                                   FontSize="62" 
                                   FontWeight="Normal" 
                                   Foreground="#111111" 
                                   Margin="130,0,0,12" 
                                   Cursor="Hand" 
                                   MouseEnter="MenuCar_MouseEnter" 
                                   MouseLeave="MenuCar_MouseLeave"
                                   MouseLeftButtonUp="MenuCar_Click" />

                        <TextBlock Text="Polestar 4&gt;" 
                                   Tag="2" 
                                   FontSize="62" 
                                   FontWeight="Normal" 
                                   Foreground="#111111" 
                                   Margin="200,0,0,12" 
                                   Cursor="Hand" 
                                   MouseEnter="MenuCar_MouseEnter" 
                                   MouseLeave="MenuCar_MouseLeave"
                                   MouseLeftButtonUp="MenuCar_Click" />

                        <TextBlock Text="Polestar 5&gt;" 
                                   Tag="3" 
                                   FontSize="62" 
                                   FontWeight="Normal" 
                                   Foreground="#111111" 
                                   Margin="270,0,0,12" 
                                   Cursor="Hand" 
                                   MouseEnter="MenuCar_MouseEnter" 
                                   MouseLeave="MenuCar_MouseLeave"
                                   MouseLeftButtonUp="MenuCar_Click" />
                    </StackPanel>

                    <!-- Imagenes de los coches -->
                    <Grid Height="300" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <Image x:Name="MenuCar0" Source="/images/2side.png" Width="680" Stretch="Uniform" Opacity="0" />
                        <Image x:Name="MenuCar1" Source="/images/3side.png" Width="680" Stretch="Uniform" Opacity="1" />
                        <Image x:Name="MenuCar2" Source="/images/4side.png" Width="680" Stretch="Uniform" Opacity="0" />
                        <Image x:Name="MenuCar3" Source="/images/5side.png" Width="680" Stretch="Uniform" Opacity="0" />
                    </Grid>

                </Grid>

                <!-- Footer -->
                <Grid x:Name="SectionFooter" MinHeight="440" Background="#111111">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" 
                           Source="/images/logo.png" 
                           Width="100" Height="100" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Top" 
                           Margin="25,90,20,45" />

                    <Grid Grid.Column="1" Margin="10,45,30,45">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="Modelos" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Polestar 2" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Polestar 3" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Polestar 4" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Polestar 5" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Comparativa de gama" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Vehículos preconfigurados" Style="{StaticResource FooterLinkStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="Comprar" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Ofertas y financiación" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Prueba de conducción" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Polestar for Business" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Entrega inmediata" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Tasación de vehículo usado" Style="{StaticResource FooterLinkStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Text="Sostenibilidad" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Objetivo Cero Emisiones" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Huella de carbono verificada" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Materiales sostenibles" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Trazabilidad de baterías" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Actualizaciones de software OTA" Style="{StaticResource FooterLinkStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3">
                            <TextBlock Text="Ayuda y Contacto" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                            <TextBlock Text="Spaces Polestar en España" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Centro de atención al cliente" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Guías y manuales" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Red de recarga pública" Style="{StaticResource FooterLinkStyle}" />
                            <TextBlock Text="Aviso legal y privacidad" Style="{StaticResource FooterLinkStyle}" />
                        </StackPanel>

                        <!-- Pie de pagina con derechos y referencia a la asignatura -->
                        <Border Grid.Row="1" Grid.ColumnSpan="4" Margin="0,32,0,0" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                            <TextBlock Text="© 2026 Polestar Performance AB. Práctica 1 - Interfaces de Usuario, Universidad Miguel Hernández (UMH)." 
                                       Foreground="#66FFFFFF" 
                                       FontSize="12" 
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Overlay de busqueda -->
        <local:SearchView x:Name="SearchOverlay" 
                          Grid.RowSpan="2" 
                          Visibility="Collapsed" 
                          Opacity="0" 
                          Panel.ZIndex="1000"
                          SearchSubmitted="SearchView_SearchSubmitted"
                          CloseRequested="SearchView_CloseRequested" />
    </Grid>
</Window>
