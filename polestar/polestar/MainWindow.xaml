<Window x:Class="polestar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:polestar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
<Grid Background="Black">
    <!-- Definisci due righe e due colonne di uguali dimensioni -->
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Placeholder per le auto (i quadrati arancioni) -->
    <!-- Quando avrai le foto, ti basterà cambiare il Source e impostare Stretch="UniformToFill" -->
    <Image Source="placeholder_auto1.png" Grid.Row="0" Grid.Column="0" Margin="5" Stretch="UniformToFill"/>
    <Image Source="placeholder_auto2.png" Grid.Row="0" Grid.Column="1" Margin="5" Stretch="UniformToFill"/>
    <Image Source="placeholder_auto3.png" Grid.Row="1" Grid.Column="0" Margin="5" Stretch="UniformToFill"/>
    <Image Source="placeholder_auto4.png" Grid.Row="1" Grid.Column="1" Margin="5" Stretch="UniformToFill"/>

    <!-- Logo Polestar Centrale -->
    <!-- Span su 2 righe e 2 colonne lo centra rispetto all'intera griglia -->
    <Image Source="polestar_logo.png" 
           Grid.RowSpan="2" 
           Grid.ColumnSpan="2" 
           HorizontalAlignment="Center" 
           VerticalAlignment="Center" 
           Width="200" Height="200" />
</Grid>
</Window>
