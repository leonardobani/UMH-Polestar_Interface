<UserControl x:Class="polestar.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Stretch"
             Background="#111114">

    <UserControl.Resources>
        <Style x:Key="StarStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="*" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Estrellas distribuidas en el cielo nocturno -->
        <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False">
            <TextBlock Style="{StaticResource StarStyle}" FontSize="24" Canvas.Left="100" Canvas.Top="80" Opacity="0.9" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="18" Canvas.Left="260" Canvas.Top="180" Opacity="0.65" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="20" Canvas.Left="420" Canvas.Top="90" Opacity="0.75" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="26" Canvas.Right="450" Canvas.Top="110" Opacity="0.85" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="18" Canvas.Right="240" Canvas.Top="190" Opacity="0.6" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="22" Canvas.Right="110" Canvas.Top="85" Opacity="0.9" />
        </Canvas>

        <!-- Boton de cierre en la esquina superior derecha -->
        <Button x:Name="BtnCloseSearch" 
                Width="44" Height="44" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,22,28,0" 
                Background="Transparent" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                ToolTipService.ToolTip="Cerrar (Esc)"
                Click="BtnCloseSearch_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="closeBrd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                        <TextBlock Text="✕" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="closeBrd" Property="Background" Value="#33FFFFFF" />
                            <Setter TargetName="closeBrd" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Logotipo de Polestar en el cielo -->
        <Image Source="/images/logo.png" 
               Width="100" Height="100" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Top" 
               Margin="0,75,0,0" />

        <!-- Carretera horizontal que cubre todo el ancho inferior -->
        <Grid VerticalAlignment="Bottom" Height="220" HorizontalAlignment="Stretch">
            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#141418" Offset="0" />
                        <GradientStop Color="#1A1A22" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Linea superior continua -->
            <Border VerticalAlignment="Top" Height="2" Background="#55FFFFFF" />

            <!-- Linea central discontinua -->
            <Line X1="0" Y1="0" X2="1" Y2="0" 
                  Stretch="Fill" 
                  VerticalAlignment="Center"
                  Stroke="#77FFFFFF" 
                  StrokeThickness="2.5" 
                  StrokeDashArray="20 16" />

            <!-- Linea inferior / banchina -->
            <Border VerticalAlignment="Bottom" Height="1" Background="#33FFFFFF" Margin="0,0,0,25" />
        </Grid>

        <!-- Conjunto centrado del cartel de busqueda y postes de apoyo -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="530" Width="480">
            <!-- Poste izquierdo -->
            <Border Width="10" 
                    Background="#1E1E24" 
                    BorderBrush="#55FFFFFF" 
                    BorderThickness="1" 
                    HorizontalAlignment="Left" 
                    Margin="60,96,0,0" />

            <!-- Poste derecho -->
            <Border Width="10" 
                    Background="#1E1E24" 
                    BorderBrush="#55FFFFFF" 
                    BorderThickness="1" 
                    HorizontalAlignment="Right" 
                    Margin="0,96,60,0" />

            <!-- Cartel con barra de busqueda -->
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                <Border Width="460" Height="96" 
                        CornerRadius="16" 
                        Background="#1A1A20" 
                        BorderBrush="White" 
                        BorderThickness="1.8">
                    <Grid Margin="22,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder" 
                                       Text="Text" 
                                       Foreground="#66FFFFFF" 
                                       FontSize="22" 
                                       FontWeight="Light" 
                                       Margin="4,0,0,0" />
                            <TextBox x:Name="SearchTextBox" 
                                     Background="Transparent" 
                                     Foreground="White" 
                                     BorderThickness="0" 
                                     FontSize="22" 
                                     VerticalContentAlignment="Center" 
                                     TextChanged="SearchTextBox_TextChanged" />
                        </Grid>

                        <Button x:Name="BtnExecuteSearch" 
                                Grid.Column="1" 
                                Width="68" Height="46" 
                                Background="Transparent" 
                                BorderThickness="0" 
                                ToolTipService.ToolTip="Buscar"
                                Click="BtnExecuteSearch_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="arrowBrd" Background="Transparent" CornerRadius="8">
                                        <Path Data="M 0,11 L 34,11 M 23,3 L 34,11 L 23,19" 
                                              Stroke="White" 
                                              StrokeThickness="2.6" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="arrowBrd" Property="Background" Value="#25FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- Texto de ayuda debajo del cartel -->
                <TextBlock Text="Escribe un modelo (ej. Polestar 2, 3, 4, 5) y presiona Enter" 
                           Foreground="#66FFFFFF" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           Margin="0,14,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
