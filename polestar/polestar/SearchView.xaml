<UserControl x:Class="polestar.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Width="840" Height="840"
             Background="#111114">

    <UserControl.Resources>
        <!-- Stile per le stelle nel cielo notturno Polestar (*) -->
        <Style x:Key="StarStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="*" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Segoe UI, Arial, sans-serif" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1. Stelle nel cielo notturno Polestar (*) -->
        <Canvas>
            <TextBlock Style="{StaticResource StarStyle}" FontSize="24" Canvas.Left="85" Canvas.Top="85" Opacity="0.9" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="18" Canvas.Left="245" Canvas.Top="210" Opacity="0.65" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="20" Canvas.Left="515" Canvas.Top="90" Opacity="0.75" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="26" Canvas.Left="655" Canvas.Top="130" Opacity="0.9" />
            <TextBlock Style="{StaticResource StarStyle}" FontSize="16" Canvas.Left="685" Canvas.Top="245" Opacity="0.55" />
        </Canvas>

        <!-- Pulsante Chiudi in alto a destra -->
        <Button x:Name="BtnCloseSearch" 
                Width="44" Height="44" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,25,0" 
                Background="Transparent" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                ToolTipService.ToolTip="Chiudi ricerca (Esc)"
                Click="BtnCloseSearch_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="closeBrd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                        <TextBlock Text="✕" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="closeBrd" Property="Background" Value="#33FFFFFF" />
                            <Setter TargetName="closeBrd" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 2. Logo in alto al centro -->
        <Image Source="/images/logo.png" 
               Width="110" Height="110" 
               HorizontalAlignment="Center" 
               VerticalAlignment="Top" 
               Margin="0,95,0,0" />


        <!-- 3. Strada orizzontale notturna in basso -->
        <Canvas HorizontalAlignment="Center" VerticalAlignment="Top" Width="840" Height="840">
            <!-- Superficie stradale asfaltata orizzontale -->
            <Rectangle Canvas.Left="0" Canvas.Top="600" Width="840" Height="240">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#141418" Offset="0" />
                        <GradientStop Color="#1A1A22" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Bordo superiore della strada (striscia continua di banchina) -->
            <Line X1="0" Y1="600" X2="840" Y2="600" 
                  Stroke="#55FFFFFF" 
                  StrokeThickness="2" />

            <!-- Linea spartitraffico centrale tratteggiata orizzontale -->
            <Line X1="0" Y1="715" X2="840" Y2="715" 
                  Stroke="#77FFFFFF" 
                  StrokeThickness="2.5" 
                  StrokeDashArray="20 16" />

            <!-- Bordo inferiore / banchina -->
            <Line X1="0" Y1="820" X2="840" Y2="820" 
                  Stroke="#33FFFFFF" 
                  StrokeThickness="1" />
        </Canvas>

        <!-- 4. Pali di supporto del cartello stradale -->
        <Border Width="10" Height="220" 
                Background="#1E1E24" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                Margin="250,380,0,0" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" />

        <Border Width="10" Height="220" 
                Background="#1E1E24" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                Margin="0,380,250,0" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" />

        <!-- 5. Cartello Stradale: Search Bar con Casella di Testo e Freccia -->
        <Border Width="460" Height="96" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,310,0,0" 
                CornerRadius="16" 
                Background="#1A1A20" 
                BorderBrush="White" 
                BorderThickness="1.8">
            <Grid Margin="22,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Casella di input dove digitare ("Text") -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SearchPlaceholder" 
                               Text="Text" 
                               Foreground="#66FFFFFF" 
                               FontSize="22" 
                               FontWeight="Light" 
                               Margin="4,0,0,0" />
                    <TextBox x:Name="SearchTextBox" 
                             Background="Transparent" 
                             Foreground="White" 
                             BorderThickness="0" 
                             FontSize="22" 
                             VerticalAlignment="Center" 
                             TextChanged="SearchTextBox_TextChanged" />
                </Grid>

                <!-- Freccia di invio ricerca verso destra -->
                <Button x:Name="BtnExecuteSearch" 
                        Grid.Column="1" 
                        Width="68" Height="46" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        ToolTipService.ToolTip="Cerca"
                        Click="BtnExecuteSearch_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="arrowBrd" Background="Transparent" CornerRadius="8">
                                <Path Data="M 0,11 L 34,11 M 23,3 L 34,11 L 23,19" 
                                      Stroke="White" 
                                      StrokeThickness="2.6" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="arrowBrd" Property="Background" Value="#25FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Testo di suggerimento sotto al cartello -->
        <TextBlock Text="Digita un modello (es. Polestar 2, 3, 4, 5) e premi Invio o la freccia" 
                   Foreground="#66FFFFFF" 
                   FontSize="12" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   Margin="0,425,0,0" />
    </Grid>
</UserControl>

