<UserControl x:Class="polestar.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="840" d:DesignWidth="840"
             Background="#111114">

    <UserControl.Resources>
        <!-- Stile per le stelle a 5 punte vettoriali del cielo notturno -->
        <Style x:Key="StarStyle" TargetType="Path">
            <Setter Property="Data" Value="M 12.0,0.0 L 14.9,8.0 L 23.4,8.3 L 16.8,13.5 L 19.1,21.7 L 12.0,17.0 L 4.9,21.7 L 7.2,13.5 L 0.6,8.3 L 9.1,8.0 Z" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.4" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 1. Stelle nel cielo notturno Polestar -->
        <Canvas>
            <Path Style="{StaticResource StarStyle}" Canvas.Left="85" Canvas.Top="90" />
            <Path Style="{StaticResource StarStyle}" Canvas.Left="245" Canvas.Top="215" />
            <Path Style="{StaticResource StarStyle}" Canvas.Left="515" Canvas.Top="95" />
            <Path Style="{StaticResource StarStyle}" Canvas.Left="655" Canvas.Top="135" />
            <Path Style="{StaticResource StarStyle}" Canvas.Left="685" Canvas.Top="250" />
        </Canvas>

        <!-- Pulsante Chiudi in alto a destra -->
        <Button x:Name="BtnCloseSearch" 
                Width="44" Height="44" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="0,20,25,0" 
                Background="Transparent" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                Cursor="Hand" 
                ToolTip="Chiudi ricerca (Esc)"
                Click="BtnCloseSearch_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="closeBrd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
                        <TextBlock Text="✕" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="closeBrd" Property="Background" Value="#33FFFFFF" />
                            <Setter TargetName="closeBrd" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- 2. Riquadro Logo in alto al centro -->
        <Border Width="260" Height="260" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,35,0,0" 
                BorderBrush="#44FFFFFF" 
                BorderThickness="1" 
                Background="#15151A">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="/images/logo.png" Width="95" Height="95" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <TextBlock Text="Logo" Foreground="#888888" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 3. Strada curvilinea in basso -->
        <Path Data="M 0,660 C 140,650 200,560 260,480 C 350,465 580,470 840,480 L 840,580 C 620,570 420,560 310,570 C 260,650 220,780 140,840 L 0,840 Z" 
              Fill="#17171C" 
              Stroke="#55FFFFFF" 
              StrokeThickness="1.5" 
              VerticalAlignment="Bottom" />

        <!-- Linea spartitraffico tratteggiata -->
        <Path Data="M 70,750 C 180,710 230,605 285,525 C 380,512 600,520 840,530" 
              Stroke="#33FFFFFF" 
              StrokeThickness="1.5" 
              StrokeDashArray="6 6" 
              VerticalAlignment="Bottom" />

        <!-- 4. Pali del cartello stradale -->
        <Border Width="10" Height="80" 
                Background="#1E1E24" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                Margin="250,380,0,0" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Top" />

        <Border Width="10" Height="80" 
                Background="#1E1E24" 
                BorderBrush="#55FFFFFF" 
                BorderThickness="1" 
                Margin="0,380,250,0" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" />

        <!-- 5. Cartello Stradale: Search Bar con Casella di Testo e Freccia -->
        <Border Width="460" Height="96" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,310,0,0" 
                CornerRadius="16" 
                Background="#1A1A20" 
                BorderBrush="White" 
                BorderThickness="1.8">
            <Grid Margin="22,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Casella di input dove digitare ("Text") -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SearchPlaceholder" 
                               Text="Text" 
                               Foreground="#66FFFFFF" 
                               FontSize="22" 
                               FontWeight="Light" 
                               IsHitTestVisible="False" 
                               Margin="4,0,0,0" />
                    <TextBox x:Name="SearchTextBox" 
                             Background="Transparent" 
                             Foreground="White" 
                             CaretBrush="White" 
                             BorderThickness="0" 
                             FontSize="22" 
                             VerticalAlignment="Center" 
                             TextChanged="SearchTextBox_TextChanged" 
                             KeyDown="SearchTextBox_KeyDown" />
                </Grid>

                <!-- Freccia di invio ricerca verso destra -->
                <Button x:Name="BtnExecuteSearch" 
                        Grid.Column="1" 
                        Width="68" Height="46" 
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand" 
                        ToolTip="Cerca"
                        Click="BtnExecuteSearch_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="arrowBrd" Background="Transparent" CornerRadius="8">
                                <Path Data="M 0,11 L 34,11 M 23,3 L 34,11 L 23,19" 
                                      Stroke="White" 
                                      StrokeThickness="2.6" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="arrowBrd" Property="Background" Value="#25FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Testo di suggerimento sotto al cartello -->
        <TextBlock Text="Digita un modello (es. Polestar 2, 3, 4, 5) e premi Invio o la freccia" 
                   Foreground="#66FFFFFF" 
                   FontSize="12" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top" 
                   Margin="0,425,0,0" />
    </Grid>
</UserControl>

