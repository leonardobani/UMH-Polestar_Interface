<Window x:Class="polestar.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Polestar - Identificación" 
        Height="630" Width="470" 
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        Background="#111114">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de navegacion comun con logotipo (Requisito Practica 1) -->
        <Border Grid.Row="0" 
                Background="#111114" 
                BorderBrush="#22FFFFFF" 
                BorderThickness="0,0,0,1" 
                Padding="22,0">
            <Grid VerticalAlignment="Center">
                <Image Source="/images/logo.png" 
                       Width="24" Height="24" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Center" 
                       Cursor="Hand" 
                       ToolTip="Ir a Inicio"
                       MouseLeftButtonUp="NavInicio_Click" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Galería" 
                               Foreground="#AAAAAA" 
                               FontSize="13" 
                               Cursor="Hand" 
                               Margin="0,0,18,0" 
                               MouseLeftButtonUp="NavGaleria_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Identificación" 
                               Foreground="White" 
                               FontWeight="SemiBold" 
                               FontSize="13" 
                               TextDecorations="Underline" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulario de identificacion -->
        <Grid Grid.Row="1">
            <StackPanel x:Name="FormLoginPanel" 
                        Width="320" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"
                        Opacity="0">
                
                <Image x:Name="LogoImage" 
                       Source="/images/logo.png" 
                       Width="65" Height="65" 
                       HorizontalAlignment="Center" 
                       RenderTransformOrigin="0.5,0.5"
                       Margin="0,0,0,18" />

                <StackPanel x:Name="FormControlsPanel">
                    <TextBlock Text="Polestar ID" 
                               Foreground="White" 
                               FontSize="24" 
                               FontWeight="Light" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,6" />

                    <TextBlock Text="Introduce tus credenciales" 
                               Foreground="#888888" 
                               FontSize="13" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,26" />

                    <TextBlock Text="Usuario" 
                               Foreground="#AAAAAA" 
                               FontSize="12" 
                               Margin="0,0,0,6" />
                    <Border Background="#1A1A20" 
                            BorderBrush="#33FFFFFF" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Height="42" 
                            Margin="0,0,0,18">
                        <TextBox x:Name="txtUsuario" 
                                 Background="Transparent" 
                                 Foreground="White" 
                                 CaretBrush="White"
                                 BorderThickness="0" 
                                 FontSize="14" 
                                 VerticalContentAlignment="Center" 
                                 Padding="12,0" />
                    </Border>

                    <TextBlock Text="Password" 
                               Foreground="#AAAAAA" 
                               FontSize="12" 
                               Margin="0,0,0,6" />
                    <Border Background="#1A1A20" 
                            BorderBrush="#33FFFFFF" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Height="42" 
                            Margin="0,0,0,24">
                        <PasswordBox x:Name="txtPassword" 
                                     Background="Transparent" 
                                     Foreground="White" 
                                     CaretBrush="White" 
                                     BorderThickness="0" 
                                     FontSize="14" 
                                     VerticalContentAlignment="Center" 
                                     Padding="12,0" />
                    </Border>

                    <Button x:Name="btnLogin" 
                            Content="Acceder" 
                            Height="44" 
                            Background="White" 
                            Foreground="Black" 
                            FontSize="14" 
                            FontWeight="SemiBold" 
                            BorderThickness="0" 
                            Cursor="Hand" 
                            IsDefault="True" 
                            Click="btnLogin_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBrd" Background="{TemplateBinding Background}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBrd" Property="Background" Value="#E0E0E0" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="btnBrd" Property="Background" Value="#CCCCCC" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock Text="Credenciales: Alumno / 1234" 
                               Foreground="#55FFFFFF" 
                               FontSize="11" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,0" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
